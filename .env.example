# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_MOCK=false # true = fake streamed replies, no OpenAI calls

# Postgres (read by docker-compose.yml on first start only)
DB_USER=llmlab
DB_PASSWORD=llmlab
DB_NAME=llmlab
DB_PORT=5432

# API (must match the DB_* values above)
DATABASE_URL=postgres://llmlab:llmlab@localhost:5432/llmlab
PORT=3001

# VPS only: domain for HTTPS via Caddy
DOMAIN=
